# Domínio público (o Caddy emite o certificado HTTPS automaticamente)
DOMAIN=financas.seudominio.com.br
PUBLIC_URL=https://financas.seudominio.com.br
CORS_ORIGINS=https://financas.seudominio.com.br

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=

# Pluggy — https://dashboard.pluggy.ai (uso comercial exige plano pago)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=

# Consultor com IA — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Login com Google — console.cloud.google.com > APIs e serviços > Credenciais > Criar
# credencial > ID do cliente OAuth > tipo "Aplicativo da Web". Em "Origens JavaScript
# autorizadas" adicione PUBLIC_URL (ex: https://financas.seudominio.com.br).
GOOGLE_CLIENT_ID=

# Ibovespa (opcional) — https://brapi.dev
BRAPI_TOKEN=

# Intervalo da sincronização automática (minutos)
SYNC_INTERVAL_MINUTES=360
