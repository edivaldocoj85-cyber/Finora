{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/app", "dest": "/frontend/app/index.html" },
    { "src": "/app/", "dest": "/frontend/app/index.html" },
    { "src": "/app/(.*)", "dest": "/frontend/app/$1" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ],
  "crons": [
    { "path": "/api/cron/sync", "schedule": "0 */6 * * *" }
  ]
}
